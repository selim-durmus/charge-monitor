<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Session traces and charger names are device-specific diagnostics; keep them off backups. -->
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
