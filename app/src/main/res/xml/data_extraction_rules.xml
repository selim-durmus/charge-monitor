<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- The live dashboard stores no user data, so there is nothing to back up. -->
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
